meta {
  name: Validate an invoice
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/validate
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:multipart-form {
  file: @file()
}

docs {
  Choose a PDF or XML file for "file". The format is detected from the content. HTTP 200 with "valid": false is an invalid invoice, not an error.
}
