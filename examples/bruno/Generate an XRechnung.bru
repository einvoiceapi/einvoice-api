meta {
  name: Generate an XRechnung
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/generate?format=xrechnung-ubl
  body: json
  auth: bearer
}

params:query {
  format: xrechnung-ubl
}

auth:bearer {
  token: {{apiKey}}
}

